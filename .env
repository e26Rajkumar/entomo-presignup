# Ports each standalone pre-signup app listens on.
PRESIGNUP_V1_PORT=6001
PRESIGNUP_V2_PORT=6002
PRESIGNUP_V3_PORT=6003

# Backend the dev server proxies /api/* to (the entomo API server).
API_PROXY_TARGET=http://localhost:3000

# Tenant subdomain to resolve on localhost (must match tenants.subdomain).
VITE_DEV_TENANT=acme-corp

# Where "Login / Get started" sends the user: the main web app, whose
# /?autoSignin=1 landing runs the real Zitadel sign-in.
VITE_WEB_APP_URL=http://localhost:5173
